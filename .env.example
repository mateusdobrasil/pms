NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=              # service role / secret key — nunca expor no cliente

# Domínios que servem o painel e o site da plataforma (não são lojas).
# "*.vercel.app" cobre a URL de produção e os previews da Vercel. Adicione aqui o domínio próprio da plataforma quando houver.
NEXT_PUBLIC_ROOT_DOMAINS=localhost,*.vercel.app

# URL pública da plataforma, usada como notification_url do Mercado Pago.
# Precisa ser https; em dev local deixe vazio (a página do pedido consulta o status sozinha).
PLATFORM_URL=

# Melhor Envio (frete). "sandbox" para testes, "production" para valer. O token fica por loja em store_secrets.
MELHOR_ENVIO_ENV=sandbox
# E-mail de contato técnico (o Melhor Envio exige no User-Agent).
MELHOR_ENVIO_CONTACT=
