NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=              # service role / secret key — nunca expor no cliente

# Domínios que servem o painel e o site da plataforma (não são lojas).
# Inclua a URL da Vercel para os previews funcionarem.
NEXT_PUBLIC_ROOT_DOMAINS=localhost,suaplataforma.com.br,pms-app.vercel.app

# URL pública da plataforma, usada como notification_url do Mercado Pago.
# Precisa ser https; em dev local deixe vazio (a página do pedido consulta o status sozinha).
PLATFORM_URL=
